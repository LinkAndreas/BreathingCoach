    "Inhale through the nose, exhale twice as long through pursed lips to slow RR and prevent air trapping.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einatmen durch die Nase, doppelt so lange durch gespitzte Lippen ausatmen, um die Atemfrequenz zu senken und ein Air Trapping zu verhindern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhale through the nose, exhale twice as long through pursed lips to slow RR and prevent air trapping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhala por la nariz, exhala el doble de tiempo con los labios fruncidos para reducir la frecuencia respiratoria y evitar el atrapamiento de aire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspirez par le nez, expirez deux fois plus longtemps à travers les lèvres pincées pour ralentir la fréquence respiratoire et éviter le piégeage de l'air."
          }
        }
      }
    },
