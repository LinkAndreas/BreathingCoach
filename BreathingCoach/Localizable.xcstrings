    "Inhale 4s, hold 7s, exhale 8s — a breath-hold-heavy pattern that raises EtCO₂ quickly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4 Sek. einatmen, 7 Sek. anhalten, 8 Sek. ausatmen — ein Muster mit langem Atemanhalten, das den EtCO₂-Wert schnell erhöht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhale 4s, hold 7s, exhale 8s — a breath-hold-heavy pattern that raises EtCO₂ quickly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhala 4 s, mantén 7 s, exhala 8 s — un patrón con retención prolongada que eleva rápidamente el EtCO₂."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspirez 4 s, retenez 7 s, expirez 8 s — un schéma avec une longue apnée qui augmente rapidement l'EtCO₂."
          }
        }
      }
    },
    "Inhale gently through your nose for 4 seconds, expanding your belly rather than your chest.": {},
    "Inhale quietly through your nose for 4 seconds.": {},
