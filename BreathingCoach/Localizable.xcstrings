          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Moy. %@ %@ · %lld%% dans la cible"
          }
        }
      },
      "comment": "History row: duration, average EtCO₂ with unit, and percentage of time in the target range."
    },
    "%@/min": {
      "comment": "A label displaying the user's current breaths per minute.",
      "isCommentAutoGenerated": true
    },
    "%lld": {
      "comment": "A label displaying a number.",
      "isCommentAutoGenerated": true
    },
