{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "comment": "A view that displays a target range and a breathing technique. The target range is displayed in a chip with a background color. The breathing technique is displayed in a chip with a background color. The button triggers a function to change the technique.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ (%@)": {
      "comment": "A plus sign is shown if the delta is positive, otherwise a minus sign.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ (%3$@)"
          }
        }
      }
    },
    "%@ breaths/min": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Atemzüge/Min"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ breaths/min"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respiraciones/min"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respirations/min"
          }
        }
      }
    },
    "%@ · %@ · %@": {
      "comment": "The date, technique name, and duration of the session. The argument is the string “%1$d:%2$02d”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@ · %3$@"
          }
        }
      }
    },
